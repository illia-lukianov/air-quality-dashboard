# PostgreSQL connection settings (PG* values take priority over legacy DB_* values).
PGHOST=localhost
PGPORT=5432
PGDATABASE=air_quality
PGUSER=
PGPASSWORD=
PGSSLMODE=disable
PGCHANNELBINDING=prefer

# Legacy names remain supported when PGHOST/PGPORT/PGDATABASE are not set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=air_quality
# DB_SSL=false

# Optional default Power BI report URL. It can also be entered in the dashboard.
NEXT_PUBLIC_POWERBI_EMBED_URL=
